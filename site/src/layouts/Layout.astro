---
// Base page shell for the static landing site. One <html lang="en">, a
// <title> from a prop, the global stylesheet, and a `min-height: 100vh` flex
// column so <Footer /> is always flush to the viewport bottom — even on a short
// page (screens.md §Source). Zero client JS.
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Copyright owner for the footer — the page passes `profile.name` (US-07);
      no owner name is hard-coded anywhere in the shell. */
  owner: string;
  /** Optional schema.org JSON-LD object, emitted as an `application/ld+json`
      data block in <head> (a page passes it built from its content — see
      `src/lib/profile-jsonld.ts`). Inert data, not executable JS: no bundle,
      no island, compatible with the zero-client-JS posture (CLAUDE.md). */
  jsonLd?: Record<string, unknown>;
  /** Open Graph object type — `profile` for a person's page, else `website`. */
  ogType?: 'website' | 'profile';
}

const { title, description, owner, jsonLd, ogType = 'website' } = Astro.props;

// Absolute, query/hash-free URL of this page — self-referencing canonical +
// og:url. `Astro.site` is the apex domain (astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png?v=4', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    {/* Open Graph / Twitter — link-preview cards. Values come from the page
       props + content; the share image is the avatar on brand navy. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
        />
      )
    }
    {/* Favicon set — regenerated with the OG image from
       docs/reference/avatar-favicon.png by `npm run gen:brand-images`
       (scripts/gen-brand-images.mjs). Bump ?v= when the art changes. */}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48.png?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png?v=4" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png?v=4" />
  </head>
  <body>
    <slot />
    <Footer owner={owner} />
  </body>
</html>

<style>
  body {
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    flex-direction: column;
  }
  /* Everything the page slots in takes the slack; the footer keeps its size. */
  body > :global(:not(footer)) {
    flex: 0 0 auto;
  }
  body > :global(main) {
    flex: 1 0 auto;
  }
  /* Belt-and-braces: even if <main> ever fails to take the slack (an empty
     page, a stale build), the auto margin drops the footer to the bottom so
     no gap opens below it. */
  body > :global(footer) {
    margin-top: auto;
  }
</style>
