---
// Base page shell for the static landing site. One <html lang="en">, a
// <title> from a prop, the global stylesheet, and a `min-height: 100vh` flex
// column so <Footer /> is always flush to the viewport bottom — even on a short
// page (screens.md §Source). Zero client JS.
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Copyright owner for the footer — the page passes `profile.name` (US-07);
      no owner name is hard-coded anywhere in the shell. */
  owner: string;
}

const { title, description, owner } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    {/* Favicon set — cropped from the same headshot the Hero renders
       (site/public/favicon/, regenerated by hand when me.png changes). */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
    <Footer owner={owner} />
  </body>
</html>

<style>
  body {
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    flex-direction: column;
  }
  /* Everything the page slots in takes the slack; the footer keeps its size. */
  body > :global(:not(footer)) {
    flex: 0 0 auto;
  }
  body > :global(main) {
    flex: 1 0 auto;
  }
  /* Belt-and-braces: even if <main> ever fails to take the slack (an empty
     page, a stale build), the auto margin drops the footer to the bottom so
     no gap opens below it. */
  body > :global(footer) {
    margin-top: auto;
  }
</style>
