---
// Site footer — dark-navy full-bleed bar, flush to the viewport bottom via the
// `min-height: 100vh` flex column in Layout.astro (screens.md §Source). The
// owner name comes from the Profile content entry (US-07: "renders entirely
// from the Profile content entry" — no page-specific copy, SAD §8), and the
// year is the build year, so neither can drift from the page.
import Band from './Band.astro';

interface Props {
  owner: string;
}

const { owner } = Astro.props;
const year = new Date().getFullYear();
---

<Band as="footer" tone="navy" class="footer">
  <p class="footer__copy">© {year} {owner}</p>
</Band>

<style>
  .footer :global(.band__inner) {
    padding-block: 1.5rem;
  }
  .footer__copy {
    margin: 0;
    text-align: center;
    font-size: 0.95rem;
  }
</style>
