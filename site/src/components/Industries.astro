---
// Optional hero right column — the domains Roman has delivered in (US-11 /
// AC-15). Renders straight from the `industries` content field; when the array
// is absent or empty the component renders nothing and the hero closes up
// (the caller also guards, so this is belt-and-braces).
interface Props {
  industries?: { domain: string; note?: string }[];
}

const { industries = [] } = Astro.props;
---

{
  industries.length > 0 && (
    <section class="industries" aria-label="Industries">
      <p class="industries__heading">Industries</p>
      <ul class="industries__list">
        {industries.map((it) => (
          <li>
            <span class="industries__domain">{it.domain}</span>
            {it.note && <span class="industries__note">{it.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .industries__heading {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .industries__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  .industries__list li {
    display: flex;
    flex-direction: column;
  }
  .industries__domain {
    font-weight: 600;
    color: var(--color-navy);
  }
  .industries__note {
    font-size: 1rem;
    color: var(--color-muted);
  }
</style>
