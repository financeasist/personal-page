---
// Hero (US-01 / AC-01). Every essential renders straight from the profile
// content: headshot, name (<h1>), headline, optional tagline, AvailabilityBlock,
// Industries, top stack. The redesign (screens.pen SCR-01) is a centered intro
// column above a two-column Availability / Industries block, then the top stack
// as one line. The page flows naturally — the hero no longer forces the fold.
//
// The headshot is the LCP element — processed by `astro:assets` (modern format,
// responsive sizes, explicit dimensions) and hinted eager + high priority
// (sad.md §8, §11 — the raw ~1.9 MB PNG would blow the budget).
import { Image } from 'astro:assets';
import AvailabilityBlock from './AvailabilityBlock.astro';
import Band from './Band.astro';
import Industries from './Industries.astro';

interface Props {
  name: string;
  headline: string;
  tagline?: string;
  topStack: string[];
  headshot: { src: string; alt: string };
  location: string;
  availability: { status: string; noticePeriod?: string; workAuthorization?: string };
  industries?: { domain: string; note?: string }[];
}

const { name, headline, tagline, topStack, headshot, location, availability, industries } =
  Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
});
const headshotEntry = assets[`../assets/${headshot.src}`];
if (!headshotEntry) {
  throw new Error(`Hero: headshot asset not found: src/assets/${headshot.src}`);
}
const headshotImage = headshotEntry.default;

const hasIndustries = Array.isArray(industries) && industries.length > 0;
---

<Band tone="canvas" class="hero">
  <div class="hero__intro">
    <Image
      class="hero__photo"
      src={headshotImage}
      alt={headshot.alt}
      width={336}
      height={336}
      widths={[192, 288, 336]}
      sizes="(min-width: 768px) 168px, 136px"
      loading="eager"
      fetchpriority="high"
    />
    <h1 class="hero__name">{name}</h1>
    <div class="hero__rule" aria-hidden="true"></div>
    <p class="hero__headline">{headline}</p>
    {tagline && <p class="hero__tagline">{tagline}</p>}
  </div>

  <div class:list={['hero__cols', hasIndustries && 'hero__cols--two']}>
    <AvailabilityBlock
      status={availability.status}
      location={location}
      noticePeriod={availability.noticePeriod}
      workAuthorization={availability.workAuthorization}
    />
    {hasIndustries && <Industries industries={industries} />}
  </div>

  <section class="hero__stack" aria-label="Top stack">
    <p class="hero__stack-label">Top stack</p>
    <p class="hero__stack-text">{topStack.join(' · ')}</p>
  </section>
</Band>

<style>
  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__photo {
    width: clamp(8.5rem, 20vw, 10.5rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid var(--color-surface);
    box-shadow: 0 14px 34px -12px color-mix(in srgb, var(--color-navy-dark) 42%, transparent);
  }
  .hero__name {
    margin: 1.1rem 0 0;
    font-size: clamp(1.6rem, 4.2vw, 2.15rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-navy-dark);
  }
  .hero__rule {
    width: 150px;
    max-width: 60%;
    height: 4px;
    border-radius: 2px;
    background: var(--color-navy);
    margin: 0.85rem 0 0.95rem;
  }
  .hero__headline {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 600;
    color: var(--color-muted);
  }
  .hero__tagline {
    margin: 1rem 0 0;
    font-style: italic;
    font-size: clamp(1rem, 1.7vw, 1.18rem);
    line-height: 1.55;
    color: var(--color-ink);
    max-width: 46rem;
  }

  .hero__cols {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: grid;
    gap: 1.5rem;
  }
  .hero__stack {
    margin-top: 1.6rem;
  }
  .hero__stack-label {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .hero__stack-text {
    /* >= 16px — the top stack is an AC-01 essential, "all text legible"
       (AC-08, spec §6 "body text >= 16px"). */
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink);
  }

  /* Laptop: Availability + Industries side by side, the block centered under
     the intro. */
  @media (min-width: 768px) {
    .hero__cols {
      max-width: 60rem;
      margin-inline: auto;
      gap: 3rem;
    }
    .hero__cols--two {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      align-items: start;
    }
    .hero__stack {
      max-width: 60rem;
      margin-inline: auto;
    }
  }
</style>
