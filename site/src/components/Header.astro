---
// Persistent sticky header — the whole of US-02. CSS-only (no client JS): the
// bar is `position: sticky` and the phone menu is a native <details> disclosure
// (AC-08). The three contact controls (email, LinkedIn, Download CV) carry
// their value ONLY in `href` — never as visible text (AC-07, AC-10, ADR-0006) —
// and a stable `data-*` hook for the roadmap-step-8 beacon.
//
// Focus / DOM order: Name → LinkedIn → email → About → Download CV
// (screens.md SCR-01 "keyboard focus"). "Contact" nav item from the .pen frame
// is omitted — there is no #contact section in v1 (spec §3 non-goal); email is
// the contact action.
import { cvFilename } from '../lib/cv-filename.js';
import { hasLinkedInLink, type LinkLike } from '../lib/content-checks';

interface Props {
  name: string;
  headline: string;
  email: string;
  links: LinkLike[];
}

const { name, headline, email, links } = Astro.props;

const linkedIn = links.find((l) => hasLinkedInLink([l]));
if (!linkedIn) {
  // The build already guarantees this (INV-03); guard so a mis-wire fails loud.
  throw new Error('Header: no linkedin.com link in contact.links');
}

const base = import.meta.env.BASE_URL;
const cvHref = `${base}${cvFilename({ name, headline })}`;
const mailto = `mailto:${email}`;
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="site-header__name" href={base}>{name}</a>

    <nav class="site-header__actions" aria-label="Contact Roman and page navigation">
      <a
        class="site-header__action site-header__action--icon"
        href={linkedIn.url}
        target="_blank"
        rel="noopener"
        data-contact-channel="linkedin"
        aria-label="Roman on LinkedIn (opens in a new tab)"
      >
        <svg class="site-header__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9.75h4v11.25H3V9.75Zm6.5 0h3.83v1.54h.05c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.14V21h-4v-4.99c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.91 1.3-1.91 2.64V21h-4V9.75Z"
          ></path>
        </svg>
        <span class="site-header__label">LinkedIn</span>
      </a>

      <a
        class="site-header__action site-header__action--icon"
        href={mailto}
        data-contact-channel="email"
        aria-label="Email Roman"
      >
        <svg class="site-header__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.2 8-5.2H4l8 5.2ZM4 8.4V18h16V8.4l-8 5.2-8-5.2Z"
          ></path>
        </svg>
        <span class="site-header__label">Email</span>
      </a>

      <a class="site-header__action site-header__action--inline" href="#about">About me</a>

      <a
        class="site-header__action site-header__action--inline"
        href={cvHref}
        download
        data-cv-download
      >
        Download CV
      </a>
    </nav>

    <details class="site-header__menu">
      <summary class="site-header__action" aria-label="Open menu">
        <svg class="site-header__glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"></path>
        </svg>
      </summary>
      <div class="site-header__menu-panel">
        <a class="site-header__menu-item" href="#about">About me</a>
        <a class="site-header__menu-item" href={cvHref} download data-cv-download>Download CV</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--color-navy-dark);
    color: #fff;
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.5rem clamp(1rem, 5vw, 2.5rem);
  }
  .site-header__name {
    margin-right: auto;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.05rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .site-header__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 44px;
    min-width: 44px;
    padding-inline: 0.6rem;
    border-radius: 0.4rem;
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
    cursor: pointer;
  }
  .site-header__action:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .site-header__action:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .site-header__glyph {
    width: 22px;
    height: 22px;
    flex: none;
  }

  /* Native <details> menu — phone only. */
  .site-header__menu {
    position: relative;
  }
  .site-header__menu > summary {
    list-style: none;
  }
  .site-header__menu > summary::-webkit-details-marker {
    display: none;
  }
  .site-header__menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    display: flex;
    flex-direction: column;
    min-width: 12rem;
    padding: 0.4rem;
    border-radius: 0.5rem;
    background: var(--color-navy-dark);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .site-header__menu-item {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border-radius: 0.4rem;
    color: #fff;
    text-decoration: none;
  }
  .site-header__menu-item:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .site-header__menu-item:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }

  /* Laptop (>=768px): show every action inline, hide the disclosure menu and
     the icon labels stay visible. */
  @media (min-width: 768px) {
    .site-header__menu {
      display: none;
    }
    .site-header__action--icon .site-header__label {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
      white-space: normal;
    }
  }

  /* Phone (<768px): icons only for LinkedIn/email, inline About/Download CV move
     into the <details> menu. */
  @media (max-width: 767.98px) {
    .site-header__action--inline {
      display: none;
    }
    .site-header__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
