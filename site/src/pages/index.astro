---
// The recruiter landing page (US-07) — composed entirely from the single
// `profile` content entry. Missing/malformed required content already failed
// the build (ADR-0007). Zero client JavaScript: no <script>, no client:*
// directive, no framework island. The step-8 click beacon is a later feature —
// this page only leaves the `data-*` hooks (in Header).
import { getCollection } from 'astro:content';
import AboutMe from '../components/AboutMe.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import { hasLinkedInLink } from '../lib/content-checks';
import { profilePersonJsonLd } from '../lib/profile-jsonld';
import Layout from '../layouts/Layout.astro';

const profiles = await getCollection('profile');
const { data: profile } = profiles[0];

const linkedInUrl = profile.contact.links.find((l) => hasLinkedInLink([l]))?.url;
// `contact.phones` is deliberately never read on this page (AC-07).

// Person / ProfilePage structured data — SEO entity signal + `sameAs` identity
// consolidation across the Hrupskyi / Grupskiy surname spellings.
const jsonLd = profilePersonJsonLd(profile, Astro.site ?? 'https://romanhrupskyi.com/');
---

<Layout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.tagline}
  owner={profile.name}
  jsonLd={jsonLd}
>
  <Header
    name={profile.name}
    headline={profile.headline}
    email={profile.contact.email}
    links={profile.contact.links}
  />
  <main>
    <Hero
      name={profile.name}
      headline={profile.headline}
      tagline={profile.tagline}
      topStack={profile.topStack}
      headshot={profile.headshot}
      location={profile.contact.location}
      availability={profile.availability}
      industries={profile.industries}
    />
    <AboutMe
      narrative={profile.about.narrative}
      highlights={profile.about.highlights}
      linkedInUrl={linkedInUrl}
    />
  </main>
</Layout>
