                                  "id": "m03vzs",
                                  "fill": "$color/muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "A background in sales and project management gives me a perspective on delivering business value through technology — aligning engineering with product goals and communicating with both technical and non-technical stakeholders.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "Inter",
                                  "fontSize": 20,
                                  "fontWeight": "normal"
                                },
