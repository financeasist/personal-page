                                  "fill": "$color/muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Comfortable using AI coding assistants and LLM-based tools as productivity multipliers for development, debugging, refactoring, testing, and technical research.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "Inter",
                                  "fontSize": 20,
