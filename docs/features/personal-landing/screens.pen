                                  "id": "V3YIPY",
                                  "fill": "$color/muted",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "My way of working is rooted in systems thinking — a holistic view of the big picture together with the ability to dive deep into the implementation details of complex systems.",
                                  "lineHeight": 1.55,
                                  "fontFamily": "Inter",
                                  "fontSize": 20,
                                  "fontWeight": "normal"
